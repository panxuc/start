# 存储模式：
# - readonly-config：读取 app/config.tsx 和内置站点设置，后台不能保存。
# - vercel-blob：通过 Vercel Blob 读写 JSON。
# - local-file：通过本地 JSON 文件读写，适合 Docker、VPS、NAS。
START_STORAGE_DRIVER=readonly-config

# local-file 模式下的默认数据目录。
START_DATA_DIR=data

# 使用 /admin 时需要设置。
# 请换成足够长的随机字符串；登录后浏览器会把它保存在 localStorage。
NAVIGATION_ADMIN_TOKEN=

# /admin 保存到 Vercel Blob 时需要设置。
# 在 Vercel 连接 Blob 存储后可以获得该 Token。
BLOB_READ_WRITE_TOKEN=

# /api/navigation 读取的公开 JSON URL。
# 留空时会使用 app/config.tsx 作为只读兜底。
NAVIGATION_BLOB_URL=

# /admin 保存导航时覆盖的 Blob 路径。
NAVIGATION_BLOB_PATH=navigation.json

# START_STORAGE_DRIVER=local-file 时使用的导航 JSON 路径。
NAVIGATION_FILE_PATH=data/navigation.local.json

# /api/site-settings 读取的公开 JSON URL。
# 留空时会使用内置站点设置。
SITE_SETTINGS_BLOB_URL=

# /admin 保存站点设置时覆盖的 Blob 路径。
SITE_SETTINGS_BLOB_PATH=site-settings.json

# START_STORAGE_DRIVER=local-file 时使用的站点设置 JSON 路径。
SITE_SETTINGS_FILE_PATH=data/site-settings.local.json
